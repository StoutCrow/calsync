# Copy to ~/.config/calsync.env and fill in. Keep this file private:
#   chmod 600 ~/.config/calsync.env
ANTHROPIC_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
CALSYNC_TIMEZONE=America/New_York
# Names as they appear on rosters, separated by commas
CALSYNC_MY_NAME=Jane Smith, Jane

# Immich (optional photo hangouts). 2283 is its default port
# Away from home, use an address you can reach, e.g. via Tailscale: http://my-server:2283
IMMICH_URL=
IMMICH_API_KEY=

# Optional: email. For Gmail use an App Password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Fixed access code, so the link on your phone keeps working after restarts.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(12))"
CALSYNC_APP_TOKEN=

# Which AI reads photos and schedules: gemini (free tier), claude, or local (Ollama)
CALSYNC_READER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LOCAL_URL=
LOCAL_MODEL=

# Optional: never look for updates on GitHub
# CALSYNC_UPDATE_CHECK=off

# Optional: rename the tabs and their subtitles (type - as the name to hide a tab)
# CALSYNC_TAB_WORK=Work
# CALSYNC_TAB_WORK_SUB=schedules
# CALSYNC_TAB_FAMILY=Home
# CALSYNC_TAB_FAMILY_SUB=calendar photo
# CALSYNC_TAB_DESCRIBE=Describe
# CALSYNC_TAB_CALENDAR=Calendar
# CALSYNC_OPEN=tab
